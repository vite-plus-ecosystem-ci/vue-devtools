{
  "name": "@vue/devtools-chrome",
  "version": "9.0.0-beta.0",
  "private": true,
  "description": "Chrome extension for Vue DevTools",
  "license": "MIT",
  "author": "webfansplz",
  "files": [
    "app",
    "dist",
    "icons",
    "manifest.json"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:scripts && pnpm run build:panel",
    "build:panel": "vp build",
    "build:scripts": "vp pack",
    "dev:panel": "vp build --watch",
    "dev:scripts": "vp pack --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@vue/devtools-client": "workspace:*",
    "@vue/devtools-kit": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/carbon": "catalog:",
    "@iconify-json/ic": "catalog:",
    "@iconify-json/logos": "catalog:",
    "@iconify-json/ri": "catalog:",
    "@types/chrome": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  }
}
